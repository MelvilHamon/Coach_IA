# ── Environment ──────────────────────────────────────────────────────────────
# APP_ENV=production                    # "development" (default) or "production"
# ALLOWED_ORIGINS=https://yourdomain.com  # Comma-separated, required in production

# ── Cookies (production) ────────────────────────────────────────────────────
# COOKIE_DOMAIN=.yourdomain.com
# SESSION_MAX_AGE_DAYS=30

# ── LLM (reviews, text-to-fit) ──────────────────────────────────────────────
# Provider configurable dans config.json : "openai" (défaut) ou "groq"
OPENAI_API_KEY=sk-...
API_KEY_GROQ=gsk_...

# ── Strava OAuth ─────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# ── Email (OTP login) ───────────────────────────────────────────────────────
# Brevo (recommended for cloud/Railway — uses HTTPS, no SMTP ports needed)
# Sign up at https://brevo.com, free tier = 300 emails/day
BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=noreply@yourdomain.com
# BREVO_FROM_NAME=CoachAgent

# Gmail SMTP fallback (blocked on most cloud providers)
# GMAIL_EXPEDITEUR=your-email@gmail.com
# GMAIL_MOT_DE_PASSE=your-app-password

# ── Database (production) ───────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/coachagent
# Leave empty to use SQLite (development only)
