# Secrets & tokens
.env
.garth/

# Données personnelles
# On ignore le CONTENU de data/ (data/*) plutôt que le dossier lui-même, pour
# pouvoir ré-inclure une exception : le référentiel public des stades, embarqué
# dans l'image Docker (un parent ignoré empêcherait toute ré-inclusion).
data/*
!data/stades_athle.json
objectif.txt
config.json

# Python
__pycache__/
*.pyc
venv/
